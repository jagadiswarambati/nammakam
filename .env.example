# ==============================================================================
# Nammakam Environment Configuration Template
# All secret values must remain placeholders. Do not commit actual credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000

# Google Cloud Project Configuration (Non-secret)
GCP_PROJECT_ID=your-gcp-project-id-placeholder
GCP_REGION=asia-south1

# Cloud Storage Bucket Names (Non-secret)
GCS_EVIDENCE_BUCKET=nammakam-evidence-artifacts-placeholder

# Cloud KMS Configuration (Non-secret identifiers)
KMS_KEY_RING=nammakam-keyring-placeholder
KMS_CRYPTO_KEY=nammakam-signing-key-placeholder
KMS_KEY_VERSION=1

# Secret Placeholders (Retrieve via Secret Manager in production)
GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY_DO_NOT_COMMIT

